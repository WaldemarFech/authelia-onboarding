@@ -0,0 +1,232 @@
+//go:build linux
+
+package authentication
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type failClosedDB struct {
+	FileUserProviderDatabase
+	loads         int
+	failRecovery  bool
+	failAfterSave bool
+}
+
+func (d *failClosedDB) Load() error {
+	d.loads++
+	if d.failRecovery && d.loads == 2 {
+		return errors.New("injected recovery failure")
+	}
+	return d.FileUserProviderDatabase.Load()
+}
+func (d *failClosedDB) Save() error {
+	if d.failAfterSave {
+		if err := d.FileUserProviderDatabase.Save(); err != nil {
+			return err
+		}
+	}
+	return errors.New("injected save failure")
+}
+
+type failClosedBlockingDB struct {
+	FileUserProviderDatabase
+	entered chan struct{}
+	proceed chan struct{}
+}
+
+func (d *failClosedBlockingDB) Save() error {
+	close(d.entered)
+	<-d.proceed
+	return d.FileUserProviderDatabase.Save()
+}
+
+func TestFailClosedAfterUncertainSave(t *testing.T) {
+	for _, tc := range []struct {
+		name                       string
+		recoveryFailure, afterSave bool
+	}{
+		{"before-rename-and-reload-failure", true, false},
+		{"save-failure-with-successful-reload", false, false},
+		{"after-save-uncertain-durability", false, true},
+		{"after-save-and-reload-failure", true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			WithDatabase(t, UserDatabaseContent, func(path string) {
+				cfg := DefaultFileAuthenticationBackendConfiguration
+				cfg.Path = path
+				p := NewFileUserProvider(&cfg)
+				require.NoError(t, p.StartupCheck())
+				p.database = &failClosedDB{FileUserProviderDatabase: p.database, failRecovery: tc.recoveryFailure, failAfterSave: tc.afterSave}
+				require.Error(t, p.UpdatePassword("john", "synthetic-new-password"))
+				for _, pw := range []string{"password", "synthetic-new-password"} {
+					ok, err := p.CheckUserPassword("john", pw)
+					require.False(t, ok)
+					require.ErrorIs(t, err, ErrOperationFailed)
+				}
+				_, err := p.GetDetails("john")
+				require.ErrorIs(t, err, ErrOperationFailed)
+				_, err = p.GetDetailsExtended("john")
+				require.ErrorIs(t, err, ErrOperationFailed)
+				require.ErrorIs(t, p.UpdatePassword("john", "other-synthetic-password"), ErrOperationFailed)
+				require.ErrorIs(t, p.ChangePassword("john", "password", "other-synthetic-password"), ErrOperationFailed)
+				_, err = p.Reload()
+				require.Error(t, err)
+				fresh := NewFileUserProvider(&cfg)
+				require.NoError(t, fresh.StartupCheck())
+				pw := "password"
+				if tc.afterSave {
+					pw = "synthetic-new-password"
+				}
+				ok, err := fresh.CheckUserPassword("john", pw)
+				require.NoError(t, err)
+				require.True(t, ok)
+			})
+		})
+	}
+}
+
+func TestAuthReadWaitsForPasswordSave(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		cfg := DefaultFileAuthenticationBackendConfiguration
+		cfg.Path = path
+		p := NewFileUserProvider(&cfg)
+		require.NoError(t, p.StartupCheck())
+		d := &failClosedBlockingDB{FileUserProviderDatabase: p.database, entered: make(chan struct{}), proceed: make(chan struct{})}
+		p.database = d
+		done := make(chan error, 1)
+		go func() { done <- p.UpdatePassword("john", "synthetic-new-password") }()
+		select {
+		case <-d.entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("save did not start")
+		}
+		result := make(chan error, 1)
+		go func() {
+			ok, err := p.CheckUserPassword("john", "synthetic-new-password")
+			if err == nil && !ok {
+				err = errors.New("password rejected")
+			}
+			result <- err
+		}()
+		select {
+		case <-result:
+			close(d.proceed)
+			<-done
+			t.Fatal("read returned before save completed")
+		case <-time.After(200 * time.Millisecond):
+		}
+		close(d.proceed)
+		require.NoError(t, <-done)
+		select {
+		case err := <-result:
+			require.NoError(t, err)
+		case <-time.After(3 * time.Second):
+			t.Fatal("read stuck")
+		}
+	})
+}
+
+func TestConcurrentAuthenticationReadsComplete(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		cfg := DefaultFileAuthenticationBackendConfiguration
+		cfg.Path = path
+		p := NewFileUserProvider(&cfg)
+		require.NoError(t, p.StartupCheck())
+		var wg sync.WaitGroup
+		errs := make(chan error, 8)
+		for range 8 {
+			wg.Add(1)
+			go func() { defer wg.Done(); _, err := p.GetDetails("john"); errs <- err }()
+		}
+		done := make(chan struct{})
+		go func() { wg.Wait(); close(done) }()
+		select {
+		case <-done:
+		case <-time.After(5 * time.Second):
+			t.Fatal("concurrent reads stuck")
+		}
+		close(errs)
+		for err := range errs {
+			require.NoError(t, err)
+		}
+		require.NoError(t, p.ChangePassword("john", "password", "synthetic-new-password"))
+	})
+}
+
+type failClosedBlockingFailureDB struct {
+	*failClosedDB
+	entered chan struct{}
+	proceed chan struct{}
+}
+
+func (d *failClosedBlockingFailureDB) Save() error {
+	close(d.entered)
+	<-d.proceed
+	return d.failClosedDB.Save()
+}
+func TestAuthReadWaitsThenRejectsAfterSaveAndRecoveryFailure(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		cfg := DefaultFileAuthenticationBackendConfiguration
+		cfg.Path = path
+		p := NewFileUserProvider(&cfg)
+		require.NoError(t, p.StartupCheck())
+		d := &failClosedBlockingFailureDB{failClosedDB: &failClosedDB{FileUserProviderDatabase: p.database, failRecovery: true}, entered: make(chan struct{}), proceed: make(chan struct{})}
+		p.database = d
+		done := make(chan error, 1)
+		go func() { done <- p.UpdatePassword("john", "synthetic-new-password") }()
+		select {
+		case <-d.entered:
+		case <-time.After(5 * time.Second):
+			t.Fatal("save did not start")
+		}
+		result := make(chan error, 1)
+		go func() { _, err := p.CheckUserPassword("john", "synthetic-new-password"); result <- err }()
+		select {
+		case <-result:
+			close(d.proceed)
+			<-done
+			t.Fatal("read returned before failed save")
+		case <-time.After(200 * time.Millisecond):
+		}
+		close(d.proceed)
+		require.Error(t, <-done)
+		select {
+		case err := <-result:
+			require.ErrorIs(t, err, ErrOperationFailed)
+		case <-time.After(3 * time.Second):
+			t.Fatal("read stuck")
+		}
+	})
+}
+
+func TestAuthorizationGuardSerializesStorageFailure(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		cfg := DefaultFileAuthenticationBackendConfiguration
+		cfg.Path = path
+		p := NewFileUserProvider(&cfg)
+		require.NoError(t, p.StartupCheck())
+		release, err := p.BeginAuthorization()
+		require.NoError(t, err)
+		d := &failClosedDB{FileUserProviderDatabase: p.database, failRecovery: true}
+		p.database = d
+		done := make(chan error, 1)
+		go func() { done <- p.UpdatePassword("john", "synthetic-new-password") }()
+		select {
+		case <-done:
+			release()
+			t.Fatal("writer crossed an active authorization decision")
+		case <-time.After(200 * time.Millisecond):
+		}
+		release()
+		require.Error(t, <-done)
+		release, err = p.BeginAuthorization()
+		require.ErrorIs(t, err, ErrOperationFailed)
+		require.Nil(t, release)
+	})
+}

+// lockFileUserDatabase takes the same stable sidecar lock as the onboarding writer.
+// Closing the returned file releases the Linux flock.
+func lockFileUserDatabase(path string) (*os.File, error) {
+	lock, err := os.OpenFile(path+".lock", os.O_RDWR|os.O_CREATE|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open user database lock: %w", err)
+	}
+
+	info, err := lock.Stat()
+	if err != nil {
+		lock.Close()
+		return nil, fmt.Errorf("failed to stat user database lock: %w", err)
+	}
+
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 || stat.Uid != uint32(os.Geteuid()) || stat.Nlink != 1 {
+		lock.Close()
+		return nil, fmt.Errorf("unsafe user database lock metadata")
+	}
+
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		err = syscall.Flock(int(lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+		if err == nil {
+			return lock, nil
+		}
+		if err == syscall.EINTR {
+			continue
+		}
+		if err != syscall.EWOULDBLOCK && err != syscall.EAGAIN {
+			lock.Close()
+			return nil, fmt.Errorf("failed to lock user database: %w", err)
+		}
+		if !time.Now().Before(deadline) {
+			lock.Close()
+			return nil, fmt.Errorf("timed out locking user database")
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}

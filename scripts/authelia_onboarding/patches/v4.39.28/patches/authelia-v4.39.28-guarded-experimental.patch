+func TestPasswordSaveFailureReloadsDiskState(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		config := DefaultFileAuthenticationBackendConfiguration
+		config.Path = path
+		provider := NewFileUserProvider(&config)
+		require.NoError(t, provider.StartupCheck())
+
+		before, err := os.ReadFile(path)
+		require.NoError(t, err)
+		beforeInfo, err := os.Stat(path)
+		require.NoError(t, err)
+		require.NoError(t, os.Chmod(path, 0644))
+
+		err = provider.UpdatePassword("john", "rejected-password")
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "unsafe authentication database metadata")
+		after, readErr := os.ReadFile(path)
+		require.NoError(t, readErr)
+		require.Equal(t, before, after)
+		afterInfo, statErr := os.Stat(path)
+		require.NoError(t, statErr)
+		require.True(t, os.SameFile(beforeInfo, afterInfo))
+
+		valid, checkErr := provider.CheckUserPassword("john", "password")
+		require.ErrorIs(t, checkErr, ErrOperationFailed)
+		require.False(t, valid)
+		valid, checkErr = provider.CheckUserPassword("john", "rejected-password")
+		require.ErrorIs(t, checkErr, ErrOperationFailed)
+		require.False(t, valid)
+	})
+}

+func TestAuthzExistingCookieDeniedAfterProviderFailure(t *testing.T) {
+	t.Run("never", func(t *testing.T) { checkAuthzExistingCookie(t, schema.NewRefreshIntervalDurationNever()) })
+	t.Run("ttl", func(t *testing.T) { checkAuthzExistingCookie(t, schema.NewRefreshIntervalDuration(5*time.Minute)) })
+}
+func checkAuthzExistingCookie(t *testing.T, refresh schema.RefreshIntervalDuration) {
+	hasher, err := argon2.New(argon2.WithM(8), argon2.WithT(1), argon2.WithP(1), argon2.WithK(32), argon2.WithS(16))
+	require.NoError(t, err)
+	digest, err := hasher.Hash("synthetic-password")
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "users.yml")
+	data := fmt.Sprintf("users:\n  john:\n    displayname: John\n    email: john@example.invalid\n    password: '%s'\n    groups: []\n", digest.Encode())
+	require.NoError(t, os.WriteFile(path, []byte(data), 0600))
+	cfg := schema.AuthenticationBackendFile{Path: path, Password: schema.DefaultPasswordConfig}
+	provider := authentication.NewFileUserProvider(&cfg)
+	require.NoError(t, provider.StartupCheck())
+	mock := mocks.NewMockAutheliaCtx(t)
+	defer mock.Close()
+	setUpMockClock(mock)
+	mock.Ctx.Providers.UserProvider = provider
+	mock.Ctx.Configuration.AuthenticationBackend.File = &cfg
+	mock.Ctx.Configuration.Session.Cookies[0].Inactivity = testInactivity
+	mock.Ctx.Providers.SessionProvider = session.NewProvider(mock.Ctx.Configuration.Session, nil)
+	target, err := url.ParseRequestURI("https://one-factor.example.com")
+	require.NoError(t, err)
+	setRequestForwardAuth(mock.Ctx, fasthttp.MethodGet, target, true, false)
+	us, err := mock.Ctx.GetSession()
+	require.NoError(t, err)
+	us.Username = "john"
+	us.AuthenticationMethodRefs.UsernameAndPassword = true
+	us.LastActivity = mock.Clock.Now().Unix()
+	us.RefreshTTL = mock.Clock.Now().Add(5 * time.Minute)
+	require.NoError(t, mock.Ctx.SaveSession(us))
+	authz := NewAuthzBuilder().WithImplementationForwardAuth().WithStrategies(NewCookieSessionAuthnStrategy(refresh)).Build()
+	authz.Handler(mock.Ctx)
+	require.Equal(t, fasthttp.StatusOK, mock.Ctx.Response.StatusCode())
+	require.NoError(t, os.Chmod(path, 0644))
+	require.Error(t, provider.UpdatePassword("john", "synthetic-new-password"))
+	mock.Ctx.Response.Reset()
+	authz.Handler(mock.Ctx)
+	require.Equal(t, fasthttp.StatusServiceUnavailable, mock.Ctx.Response.StatusCode())
+}

+func TestReloadAfterNativeSaveAndRapidOnboardingChanges(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		config := DefaultFileAuthenticationBackendConfiguration
+		config.Path = path
+		provider := NewFileUserProvider(&config)
+		require.NoError(t, provider.StartupCheck())
+		require.NoError(t, provider.UpdatePassword("john", "new-password"))
+
+		model := &FileDatabaseModel{}
+		require.NoError(t, model.Read(path))
+		john := model.Users["john"]
+		john.Groups = append(john.Groups, "onboarded")
+		model.Users["john"] = john
+		require.NoError(t, model.Write(path))
+		reloaded, err := provider.Reload()
+		require.NoError(t, err)
+		require.True(t, reloaded)
+		details, err := provider.GetDetails("john")
+		require.NoError(t, err)
+		require.Contains(t, details.Groups, "onboarded")
+
+		model = &FileDatabaseModel{}
+		require.NoError(t, model.Read(path))
+		john = model.Users["john"]
+		john.Disabled = true
+		model.Users["john"] = john
+		require.NoError(t, model.Write(path))
+		reloaded, err = provider.Reload()
+		require.NoError(t, err)
+		require.True(t, reloaded)
+		_, err = provider.GetDetails("john")
+		require.ErrorIs(t, err, ErrUserNotFound)
+	})
+}

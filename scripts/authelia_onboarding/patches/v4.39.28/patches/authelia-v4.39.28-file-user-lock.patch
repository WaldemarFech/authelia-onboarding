+// replaceUsersLikeOnboarding swaps the YAML inode, as the external onboarding writer does.
+func replaceUsersLikeOnboarding(t *testing.T, path string) {
+	t.Helper()
+
+	current, err := os.ReadFile(path)
+	require.NoError(t, err)
+	anchor := "      - admins\n      - dev\n"
+	require.Contains(t, string(current), anchor)
+	updated := strings.Replace(string(current), anchor, anchor+"      - onboarded\n", 1)
+
+	temp, err := os.CreateTemp(filepath.Dir(path), ".onboarding-users-*")
+	require.NoError(t, err)
+	defer os.Remove(temp.Name())
+	_, err = temp.WriteString(updated)
+	require.NoError(t, err)
+	require.NoError(t, temp.Sync())
+	require.NoError(t, temp.Close())
+	require.NoError(t, os.Rename(temp.Name(), path))
+}
+
+func TestPasswordWritesPreserveOnboardingEditAndDisabledUser(t *testing.T) {
+	cases := []struct {
+		name  string
+		write func(*FileUserProvider) error
+	}{
+		{"reset", func(p *FileUserProvider) error { return p.UpdatePassword("john", "after-onboarding") }},
+		{"change", func(p *FileUserProvider) error { return p.ChangePassword("john", "password", "after-onboarding") }},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			WithDatabase(t, UserDatabaseContent, func(path string) {
+				config := DefaultFileAuthenticationBackendConfiguration
+				config.Path = path
+				provider := NewFileUserProvider(&config)
+				require.NoError(t, provider.StartupCheck())
+
+				replaceUsersLikeOnboarding(t, path)
+				before, err := os.Stat(path)
+				require.NoError(t, err)
+				require.NoError(t, tc.write(provider))
+
+				after, err := os.Stat(path)
+				require.NoError(t, err)
+				require.False(t, os.SameFile(before, after), "native Save must replace the YAML inode")
+				require.Equal(t, os.FileMode(0600), after.Mode().Perm())
+				leftovers, err := filepath.Glob(filepath.Join(filepath.Dir(path), "."+filepath.Base(path)+".authelia-*"))
+				require.NoError(t, err)
+				require.Empty(t, leftovers)
+
+				model := &FileDatabaseModel{}
+				require.NoError(t, model.Read(path))
+				require.Contains(t, model.Users["john"].Groups, "onboarded")
+				require.True(t, model.Users["dis"].Disabled)
+
+				fresh := NewFileUserProvider(&config)
+				require.NoError(t, fresh.StartupCheck())
+				valid, err := fresh.CheckUserPassword("john", "after-onboarding")
+				require.NoError(t, err)
+				require.True(t, valid)
+				_, err = fresh.GetDetails("dis")
+				require.ErrorIs(t, err, ErrUserNotFound)
+			})
+		})
+	}
+}

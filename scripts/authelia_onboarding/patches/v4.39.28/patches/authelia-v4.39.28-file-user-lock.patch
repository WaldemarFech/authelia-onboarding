+func TestPasswordUpdateCoordinatesWithOnboardingLock(t *testing.T) {
+	WithDatabase(t, UserDatabaseContent, func(path string) {
+		config := DefaultFileAuthenticationBackendConfiguration
+		config.Path = path
+		provider := NewFileUserProvider(&config)
+		require.NoError(t, provider.StartupCheck())
+
+		lock, err := os.OpenFile(path+".lock", os.O_RDWR|os.O_CREATE, 0600)
+		require.NoError(t, err)
+		defer lock.Close()
+		require.NoError(t, syscall.Flock(int(lock.Fd()), syscall.LOCK_EX))
+
+		done := make(chan error, 1)
+		started := make(chan struct{})
+		go func() {
+			close(started)
+			done <- provider.UpdatePassword("john", "after-onboarding")
+		}()
+		select {
+		case <-started:
+		case <-time.After(5 * time.Second):
+			t.Fatal("native password update goroutine did not start")
+		}
+		deadline := time.Now().Add(5 * time.Second)
+		for provider.mutex.TryLock() {
+			provider.mutex.Unlock()
+			if !time.Now().Before(deadline) {
+				t.Fatal("native password update did not acquire the provider mutex")
+			}
+			time.Sleep(5 * time.Millisecond)
+		}
+		select {
+		case err := <-done:
+			t.Fatalf("native write completed while onboarding held the lock: %v", err)
+		default:
+		}
+		replaceUsersLikeOnboarding(t, path)
+		require.NoError(t, syscall.Flock(int(lock.Fd()), syscall.LOCK_UN))
+
+		select {
+		case err := <-done:
+			require.NoError(t, err)
+		case <-time.After(30 * time.Second):
+			t.Fatal("native password update did not finish after releasing the lock")
+		}
+
+		model := &FileDatabaseModel{}
+		require.NoError(t, model.Read(path))
+		require.Contains(t, model.Users["john"].Groups, "onboarded")
+		require.True(t, model.Users["dis"].Disabled)
+		fresh := NewFileUserProvider(&config)
+		require.NoError(t, fresh.StartupCheck())
+		valid, err := fresh.CheckUserPassword("john", "after-onboarding")
+		require.NoError(t, err)
+		require.True(t, valid)
+	})
+}
